{
  "plugin": "proxbox",
  "schema_version": "1",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List active, failed, and recurring Proxbox synchronization jobs visible to the current NetBox principal.",
      "effect": "read",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "method": "GET",
      "name": "list_sync_jobs",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "scheduled_jobs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minimum": 1,
                  "type": "integer"
                },
                "interval": {
                  "maximum": 2147483647,
                  "minimum": 1,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pk": {
                  "minimum": 1,
                  "type": "integer"
                },
                "schedule": {
                  "format": "date-time",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string"
                },
                "sync_types": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "id",
                "pk",
                "name",
                "sync_types",
                "schedule",
                "interval",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "scheduled_jobs"
        ],
        "type": "object"
      },
      "path": "sync/schedule/",
      "title": "List Proxbox sync jobs"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Queue an immediate, future, or recurring Proxbox synchronization through the existing permission-gated scheduling API. Reconciliation may delete stale NetBox inventory records. The bridge calls use explicit concrete sync stages; a full sync is the exact complete stage list. Stage selection controls the thirteen backend SSE reconciliation stages; invariant endpoint preflight plus cluster/node, firewall, datacenter, and VM-template reconciliation still run before them for every MCP-scheduled job (VM templates may be disabled by sync mode). Recurrence contains exactly one bounded unit/value member. An explicit Proxmox endpoint scope must contain at least one ID; omit it to select all.",
      "effect": "destructive",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "job_name": {
            "maxLength": 200,
            "type": "string"
          },
          "proxmox_endpoint_ids": {
            "items": {
              "description": "Use an integer JSON literal for IDs above 9007199254740991; decimal-form numbers are accepted only while exactly representable by IEEE 754.",
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "recurrence": {
            "additionalProperties": false,
            "description": "Exactly one bounded unit/value member; omit for a one-shot job.",
            "maxProperties": 1,
            "minProperties": 1,
            "properties": {
              "days": {
                "maximum": 1491308,
                "minimum": 1,
                "type": "integer"
              },
              "hours": {
                "maximum": 35791394,
                "minimum": 1,
                "type": "integer"
              },
              "minutes": {
                "maximum": 2147483647,
                "minimum": 1,
                "type": "integer"
              },
              "weeks": {
                "maximum": 213044,
                "minimum": 1,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "schedule_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "sync_stages": {
            "items": {
              "enum": [
                "virtual-machines",
                "storage",
                "vm-disks",
                "vm-backups",
                "vm-snapshots",
                "devices",
                "network-interfaces",
                "vm-interfaces",
                "ip-addresses",
                "sdn",
                "backup-routines",
                "replications",
                "task-history"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "sync_stages"
        ],
        "type": "object"
      },
      "method": "POST",
      "name": "schedule_sync",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok",
          "job_id",
          "message"
        ],
        "type": "object"
      },
      "path": "sync/schedule/",
      "title": "Schedule a Proxbox synchronization"
    }
  ]
}
